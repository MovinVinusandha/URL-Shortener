# Dual-Mode Feature Flags
APP_SELF_HOSTED=false
ALLOW_REGISTRATION=true
REQUIRE_EMAIL_VERIFICATION=true

# Database Configuration (MySQL)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/url_shortener?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_secure_db_password

# Cache Configuration (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379

# Security & Authentication (HMAC-SHA 256-bit Key)
JWT_SECRET=your_super_secret_jwt_key_at_least_256_bits
ROOT_USER_EMAIL=admin@example.com
ROOT_USER_PASSWORD=your_secure_admin_password

# Domain & Redirection Routing
# Base URL used by Spring Boot to construct generated short links
ROOT_DOMAIN_URL=http://localhost:8080

# Allowed origins for Spring Security CORS configuration
APP_DOMAIN_URL=http://localhost:5173,http://localhost

# Frontend application URL for password unlock (/secure) and expired (/expired) redirects
APP_DASHBOARD_URL=http://app.localhost

# General frontend origin URL
FRONTEND_URL=http://localhost

# Email & SMTP Configuration
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-app-specific-password
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS_ENABLE=true
SPRING_MAIL_SMTP_STARTTLS_REQUIRED=true

# OAuth 2.0 (Google & GitHub)
OAUTH_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
OAUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret
OAUTH_GITHUB_CLIENT_ID=your-github-client-id
OAUTH_GITHUB_CLIENT_SECRET=your-github-client-secret
