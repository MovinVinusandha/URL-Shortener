# 1. NGINX SUBDOMAIN ROUTING (Domain names without protocol or port)
API_DOMAIN_NAME=api.trim.com
APP_DOMAIN_NAME=app.trim.com
ROOT_DOMAIN_NAME=trim.com

# 2. BACKEND CONFIGURATION (Spring Boot)
# Fully qualified base URL used by Spring Boot to construct generated short links
ROOT_DOMAIN_URL=https://trim.com

# Allowed origins for Spring Security CORS configuration (comma-separated if multiple)
APP_DOMAIN_URL=https://app.trim.com

# Frontend URL used for redirecting to password unlock (/secure) and expired (/expired) pages
APP_DASHBOARD_URL=https://app.trim.com

# General frontend origin URL
FRONTEND_URL=https://trim.com

# 3. FRONTEND CONFIGURATION (Vite/React)
# Base URL for Axios HTTP requests to the Spring Boot REST API
VITE_API_BASE_URL=https://api.trim.com

# Base domain displayed in the link creation input prefix
VITE_ROOT_DOMAIN=https://trim.com

# 4. DATABASE SETTINGS (MySQL)
MYSQL_ROOT_PASSWORD=GENERATED_STRONG_PASSWORD_HERE
MYSQL_DATABASE=url_shortener
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/url_shortener?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=GENERATED_STRONG_PASSWORD_HERE

# 5. CACHING SETTINGS (Redis)
REDIS_HOST=redis
REDIS_PORT=6379

# 6. SECURITY & AUTHENTICATION
# 256-bit secure secret key (generate with: openssl rand -base64 32)
JWT_SECRET=GENERATED_SECURE_256_BIT_KEY_HERE
ROOT_USER_EMAIL=admin@trim.com
ROOT_USER_PASSWORD=GENERATED_STRONG_ADMIN_PASSWORD

# 7. EMAIL & SMTP CONFIGURATION (Gmail, SendGrid, Amazon SES, etc.)
# For local development without SMTP, leave these empty (emails will log to console)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-app-specific-password
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS_ENABLE=true
SPRING_MAIL_SMTP_STARTTLS_REQUIRED=true

# 8. OAUTH 2.0 AUTHENTICATION (Google & GitHub)
# Google Developer Console: https://console.cloud.google.com/apis/credentials
# Authorized Redirect URI: ${ROOT_DOMAIN_URL}/auth/oauth/google/callback
OAUTH_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
OAUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub Developer Settings: https://github.com/settings/developers
# Authorization Callback URL: ${ROOT_DOMAIN_URL}/auth/oauth/github/callback
OAUTH_GITHUB_CLIENT_ID=your-github-client-id
OAUTH_GITHUB_CLIENT_SECRET=your-github-client-secret